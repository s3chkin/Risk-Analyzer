@using Microsoft.AspNetCore.Identity
@using RiskAnalyzer.Data.Models
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

<ul class="navbar-nav app-nav-auth ms-lg-auto align-items-lg-center gap-lg-1">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item d-none d-lg-flex align-items-center">
        <span class="navbar-text text-white-50 small me-1">@User.Identity?.Name</span>
    </li>
    <li class="nav-item">
        <a class="nav-link small py-lg-2" asp-area="Identity" asp-page="/Account/Manage/Index" title="Профил">Профил</a>
    </li>
    <li class="nav-item">
        <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Reporting", new { area = "" })">
            <button type="submit" class="nav-link btn btn-link btn-nav-logout">Изход</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link btn btn-sm btn-nav-register" asp-area="Identity" asp-page="/Account/Register">Регистрация</a>
    </li>
    <li class="nav-item">
        <a class="nav-link btn btn-sm btn-nav-login" asp-area="Identity" asp-page="/Account/Login">Вход</a>
    </li>
}
</ul>
