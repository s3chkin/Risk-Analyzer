<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RiskAnalyzer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RiskAnalyzer.styles.css" asp-append-version="true" />
</head>
<body class="app-body">
    <header class="app-header">
        <nav class="navbar navbar-expand-lg navbar-dark app-navbar">
            <div class="container-xxl">
                <a class="navbar-brand app-brand" asp-controller="Reporting" asp-action="Index">
                    <span class="app-brand__mark" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 3L20 7V17L12 21L4 17V7L12 3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                            <path d="M12 8V16M8 10L16 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                        </svg>
                    </span>
                    <span class="app-brand__text">RiskAnalyzer</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#appNav" aria-controls="appNav"
                        aria-expanded="false" aria-label="Меню">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="appNav">
                    <ul class="navbar-nav flex-grow-1 mt-2 mt-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Reporting" asp-action="Index">Отчетност</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="RiskTypes" asp-action="Index">Типове риск</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Scenarios" asp-action="Index">Сценарии</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Criteria" asp-action="Index">Критерии</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Decisions" asp-action="Index">Оценки</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="app-main">
        <div class="container-xxl px-3 px-lg-4 py-4">
            @RenderBody()
        </div>
    </main>

    <footer class="app-footer">
        <div class="container-xxl px-3 px-lg-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>&copy; 2026 RiskAnalyzer — платформа за оценка на природни рискове</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
