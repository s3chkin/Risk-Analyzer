@model ErrorViewModel
@{
    ViewData["Title"] = "Грешка";
}

<div class="page-content">
    <div class="app-alert-error">
        <h1 class="h4 mb-2">Възникна грешка</h1>
        <p class="mb-0">Заявката не можа да бъде обработена. Опитайте отново по-късно.</p>
        @if (Model.ShowRequestId)
        {
            <p class="mt-3 mb-0 small"><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
        }
    </div>
    <p class="text-muted small mt-4">
        В среда <strong>Development</strong> се показват повече детайли за изключенията. За продукция задайте <code>ASPNETCORE_ENVIRONMENT</code> на <code>Production</code>.
    </p>
</div>
