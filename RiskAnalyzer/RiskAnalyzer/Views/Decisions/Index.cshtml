@model IEnumerable<RiskAnalyzer.Models.InputDecisionsModel>

<div class="page-content">
    <div class="page-toolbar">
        <h2>Оценки (решения)</h2>
        <a asp-action="Add" class="btn btn-primary">Нова оценка</a>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0 app-table">
                <thead>
                    <tr>
                        <th>Дата</th>
                        <th>Отчет от</th>
                        <th>Сценарий</th>
                        <th>Критерий</th>
                        <th>Оценка (1–10)</th>
                        <th>Изчислен риск</th>
                        <th>Препоръка</th>
                        <th class="text-end">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="app-empty">Няма записани оценки.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-nowrap">@item.Timestamp.ToString("g")</td>
                            <td>@(string.IsNullOrEmpty(item.DecidedByUserName) ? "—" : item.DecidedByUserName)</td>
                            <td class="fw-semibold">@item.ScenarioTitle</td>
                            <td>@item.CriterionName</td>
                            <td><span class="badge bg-secondary">@item.Score</span></td>
                            <td>
                                <span class="badge @(item.CalculatedValue >= 60 ? "bg-danger" : (item.CalculatedValue >= 30 ? "bg-warning text-dark" : "bg-success"))">
                                    @item.CalculatedValue.ToString("0.00")
                                </span>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.RecommendedAction))
                                {
                                    <span title="@item.Notes">@item.RecommendedAction</span>
                                }
                                else if (!string.IsNullOrWhiteSpace(item.Notes))
                                {
                                    <span class="text-muted small">@(item.Notes.Length > 40 ? item.Notes.Substring(0, 40) + "…" : item.Notes)</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (item.CanDelete)
                                {
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Изтриване?')">Изтрий</a>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
