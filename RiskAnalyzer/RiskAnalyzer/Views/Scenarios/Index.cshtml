@model IEnumerable<InputScenariosModel>
<div class="page-content">
    <div class="page-toolbar">
        <h2>Сценарии</h2>
        <a asp-action="Add" class="btn btn-primary">Нов сценарий</a>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0 app-table">
                <thead>
                    <tr>
                        <th>Заглавие</th>
                        <th>Локация</th>
                        <th>Тип риск</th>
                        <th>Статус</th>
                        <th class="text-end" style="min-width: 220px;">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="app-empty">Няма добавени сценарии.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@item.Title</td>
                                <td>@item.Location</td>
                                <td>@item.RiskTypeName</td>
                                <td><span class="badge bg-info text-dark">@item.Status</span></td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Детайли</a>
                                    @if (item.CanEdit)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Редактирай</a>
                                    }
                                    @if (item.CanDelete)
                                    {
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Сигурен ли си?')">Изтрий</a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
