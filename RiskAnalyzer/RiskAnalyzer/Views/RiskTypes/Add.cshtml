@model RiskAnalyzer.Models.InputRiskTypesModel

<div class="page-content">
    <div class="app-form-panel">
        <div class="card app-card shadow-sm">
            <div class="card-header app-card__header">
                <h2 class="h5 mb-0">Нов тип риск</h2>
            </div>
            <div class="card-body p-4">
                <form asp-action="Add" method="post">
                    <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Име на типа</label>
                        <input asp-for="Name" class="form-control" placeholder="Напр. наводнение, свлачище…" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold">Описание</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Кратко пояснение за типа риск"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary">Добави</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Назад към списъка</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
