@model IEnumerable<RiskAnalyzer.Models.InputCriteriaModel>

<div class="page-content">
    <div class="page-toolbar">
        <h2>Критерии за оценка</h2>
        <a asp-action="Add" class="btn btn-primary">Нов критерий</a>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped mb-0 app-table">
                <thead>
                    <tr>
                        <th>Име на критерия</th>
                        <th>Тежест (weight)</th>
                        <th class="text-end" style="min-width: 200px;">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="3" class="app-empty">Няма добавени критерии.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Name</td>
                            <td><span class="badge bg-secondary">@item.Weight</span></td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Детайли</a>
                                @if (item.CanEdit)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Редактирай</a>
                                }
                                @if (item.CanDelete)
                                {
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Сигурен ли си?')">Изтрий</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
