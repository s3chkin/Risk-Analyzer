@model RiskAnalyzer.Models.InputCriteriaModel

<div class="page-content">
    <div class="app-form-panel">
        <div class="card app-card shadow-sm">
            <div class="card-header app-card__header">
                <h2 class="h5 mb-0">Редактиране на критерий</h2>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Име на критерия</label>
                        <input asp-for="Name" class="form-control" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Тежест (1–10)</label>
                        <input asp-for="Weight" type="number" class="form-control" min="1" max="10" />
                        <span asp-validation-for="Weight" class="text-danger small"></span>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary">Обнови</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Назад</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
